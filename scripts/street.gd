extends Node2D
# Large Rubinshteyna district. Art and layout are generated by tools/district/gen_district.py.

const LAYOUT = preload("res://scripts/district_layout.gd")
const MAP_SIZE: Vector2 = LAYOUT.MAP_SIZE
const ARRIVAL: Vector2 = LAYOUT.ARRIVAL
const COURTYARD: Rect2 = LAYOUT.APARTMENT_DOOR
const SERVICE_DOOR: Rect2 = LAYOUT.RESTAURANT_DOOR
const SOLIDS: Array[Rect2] = LAYOUT.SOLIDS

static func area_name(point: Vector2) -> String:
	for area in LAYOUT.AREAS:
		var rect: Rect2 = area[0]
		if rect.has_point(point):
			return area[1]
	return "Улица Рубинштейна"

func _ready() -> void:
	texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	y_sort_enabled = true
	for chunk in LAYOUT.CHUNKS:
		var ground := Sprite2D.new()
		ground.texture = load("res://assets/district/%s" % chunk[0])
		ground.centered = false
		ground.position = chunk[1]
		ground.z_index = -1
		add_child(ground)
	var textures := {}
	for prop in LAYOUT.PROPS:
		var prop_name: String = prop[0]
		if not textures.has(prop_name):
			textures[prop_name] = load("res://assets/district/props/%s.png" % prop_name)
		var texture: Texture2D = textures[prop_name]
		var anchor: Vector2 = LAYOUT.ANCHORS[prop_name]
		var flip: bool = prop[2]
		var sprite := Sprite2D.new()
		sprite.texture = texture
		sprite.centered = false
		sprite.flip_h = flip
		sprite.offset = -Vector2(texture.get_width() - anchor.x if flip else anchor.x, anchor.y)
		sprite.position = prop[1]
		add_child(sprite)
